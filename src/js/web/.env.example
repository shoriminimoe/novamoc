# Bearer token attached to every API request from the SPA. The server
# resolves it to a tenant id (see src/py/novamoc/domain/accounts/_resolver.py).
# Single dev token until the per-tenant registry lands (issue #19).
VITE_DEFAULT_BEARER_TOKEN=t1-dev-token

# Optional API base URL override. Leave empty to use Vite's dev proxy,
# which forwards /schema, /events, /problems, /openapi to NOVAMOC_API_URL
# (default http://127.0.0.1:8000).
VITE_API_BASE_URL=

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Override root .gitignore patterns that legitimately apply to Python
# build artifacts but accidentally match SPA source / lockfile / env template.
!src/lib/
!package-lock.json
!.env.example
!src/app.d.ts

# SvelteKit (ADR-021): generated types / sync output. Regenerated by
# `svelte-kit sync` (runs automatically before `dev`, `build`, `check`).
.svelte-kit/
build/

